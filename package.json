{
    "name": "hand-mouse-control",
    "version": "1.0.0",
    "description": "Control your mouse with hand gestures using your camera",
    "main": "src/main.js",
    "scripts": {
        "start": "node scripts/copy-mediapipe.js && electron .",
        "build": "node scripts/copy-mediapipe.js && electron-builder --win",
        "pack": "node scripts/copy-mediapipe.js && electron-builder --win --dir",
        "vendor:mediapipe": "node scripts/copy-mediapipe.js",
        "postinstall": "node scripts/copy-mediapipe.js",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix"
    },
    "author": "HandMouse",
    "license": "MIT",
    "devDependencies": {
        "electron": "^28.1.0",
        "electron-builder": "^24.9.1",
        "eslint": "^8.57.0"
    },
    "dependencies": {
        "@mediapipe/camera_utils": "^0.3.1675466862",
        "@mediapipe/drawing_utils": "^0.3.1675466124",
        "@mediapipe/hands": "^0.4.1675469240",
        "@nut-tree-fork/nut-js": "^4.2.2"
    },
    "build": {
        "appId": "com.handmouse.control",
        "productName": "Hand Mouse Control",
        "win": {
            "target": "nsis",
            "icon": "assets/icon.png"
        },
        "files": [
            "src/**/*",
            "node_modules/**/*"
        ]
    }
}
